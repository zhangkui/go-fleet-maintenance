# 可选覆盖：不复制为 .env 也能直接 docker compose up --build 启动。
# Compose 已自带安全的本地默认值，下面仅用于覆盖。

# HTTP_ADDR=:8080
# MYSQL_DSN=fleet:fleet_pwd@tcp(mysql:3306)/fleet?parseTime=true&loc=Asia%2FShanghai&charset=utf8mb4&collation=utf8mb4_unicode_ci
# REDIS_ADDR=redis:6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_KEY_PREFIX=fleet:
# TOKEN_ISSUER=go-fleet-maintenance
# JWT_SECRET=local-acceptance-secret-change-me
# ACCESS_TOKEN_TTL=30m
# REFRESH_TOKEN_TTL=168h
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=Admin123!
# LOGIN_RATE_LIMIT=5
# LOGIN_RATE_WINDOW=1m
# TZ=Asia/Shanghai
# REQUEST_MAX_BYTES=1048576

# 本地集成测试用（连 Docker 映射端口）：
# MYSQL_DSN=fleet:fleet_pwd@tcp(127.0.0.1:13306)/fleet?parseTime=true&loc=Asia%2FShanghai&charset=utf8mb4&collation=utf8mb4_unicode_ci
# REDIS_ADDR=127.0.0.1:16379
